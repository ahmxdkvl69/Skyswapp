# Copy to .env and fill in. Never commit the real .env.

# --- Database (Neon) ---------------------------------------------------------
# Neon dashboard -> your project -> Connect. Use the POOLED string (the host
# ends in "-pooler"), which is what serverless deployments need.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Flask -------------------------------------------------------------------
# Sessions are signed with this. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-secret

# Admin account, created by init_db.py. Signs in like any other user (no OTP)
# because its role is 'admin'. Re-running init_db.py resets this password.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Administrator

# Legacy backdoor: grants admin access under ANY email, via an emailed OTP.
# Leave blank to disable it and rely on the account above.
ADMIN_MASTER_PASSWORD=StrongPassword@2026

# Timezone used when displaying stored timestamps.
APP_TIMEZONE=Asia/Karachi

# --- EmailJS (OTP + notification emails) -------------------------------------
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_USER_ID=
EMAILJS_PRIVATE_KEY=

# --- Demo login created by init_db.py ----------------------------------------
DEMO_USER_EMAIL=user@gmail.com
DEMO_USER_PASSWORD=12345678
DEMO_USER_NAME=Atta Raja
